# ===== 秋招投递追踪表 配置示例 =====
# 普通用户不用手动改这个文件：打开看板后，点右上角「设置」在页面里填即可，程序会自动写进 .env。
# 这里只是告诉你程序会用到哪些项。

# --- 邮箱（扫招聘邮件用）---
# 邮箱提供商：gmail / qq / 163 / 126 / outlook / other（页面里选中后自动填）
GMAIL_PROVIDER=gmail
GMAIL_EMAIL=你的邮箱@xxx.com
GMAIL_APP_PASSWORD=你的16位应用专用密码/授权码
# IMAP 服务器（页面里选提供商后自动填，一般不用改）
GMAIL_IMAP_HOST=imap.gmail.com

# --- AI 模型（识别公司/岗位/状态用）---
# 模型提供商：deepseek / openai / moonshot / qwen / zhipu / volcengine / siliconflow / ollama / custom
# （页面里选提供商后，接口地址和模型名自动填好，用户只需填 API Key）
MODEL_PROVIDER=deepseek
MODEL_API_KEY=sk-你的模型API密钥
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
